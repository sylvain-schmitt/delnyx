<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Delnyx
			{% endblock %}
		</title>

		{# Favicon
		   ⚠️ Le SVG a été RETIRÉ. Ce n'était pas un vecteur : un PNG de 512×512 encodé en
		   base64 dans une balise <image>, 442 Ko, zéro tracé. Edge et Chrome préfèrent
		   image/svg+xml quand il est déclaré — ils téléchargeaient donc 442 Ko à chaque
		   page pour rastériser une bitmap, et Edge n'affichait rien du tout.
		   Le PNG 96×96 fait le même travail en 23 Ko.

		   Le .ico est AUSSI copié à la racine (public/favicon.ico) : Edge demande
		   /favicon.ico en direct pour les favoris, l'historique et les vignettes du
		   nouvel onglet, sans lire les balises de la page. Il renvoyait 404. #}
		<link rel="icon" type="image/png" href="{{ asset('images/favicon/favicon-96x96.png') }}" sizes="96x96"/>
		<link rel="shortcut icon" href="{{ asset('images/favicon/favicon.ico') }}"/>
		<link rel="apple-touch-icon" sizes="180x180" href="{{ asset('images/favicon/apple-touch-icon.png') }}"/>
		{# Racine, pas asset() : le manifeste référence ses icônes par chemin absolu,
		   et AssetMapper leur donnerait une empreinte qu'il ne peut pas connaître. #}
		<link rel="manifest" href="/site.webmanifest"/>

		{# Stylesheets #}
		{% block stylesheets %}
			<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
		{% endblock %}

		{# JavaScripts #}
		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body
		class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-700 min-h-screen">

		{# Header simplifié #}
		<header class="bg-white/10 backdrop-blur-xl border-b border-white/20">
			<div class="container mx-auto px-4 py-6">
				<div class="flex items-center justify-between">
					<div class="flex items-center">
						<img src="{{ asset('images/logo-delnyx.svg') }}" alt="Delnyx" class="h-8 w-auto">
					</div>
					{% block header_actions %}{% endblock %}
				</div>
			</div>
		</header>

		{# Main Content #}
		<main
			class="container mx-auto px-4 py-8">
			{# Flash Messages #}
			{% for type, messages in app.flashes %}
				{% for message in messages %}
					<div class="mb-4 p-4 rounded-lg border-l-4 {% if type == 'success' %}bg-green-500/20 border-green-500 text-green-300{% else %}bg-red-500/20 border-red-500 text-red-300{% endif %}">
						<div class="flex items-center">
							<div class="flex-1">{{ message|raw }}</div>
						</div>
					</div>
				{% endfor %}
			{% endfor %}

			{# Page Content #}
			{% block body %}{% endblock %}
		</main>

		{# Footer #}
		<footer class="bg-white/5 border-t border-white/10 mt-12">
			<div class="container mx-auto px-4 py-6 text-center text-white/60 text-sm">
				<p>&copy;
					{{ 'now'|date('Y') }}
					Delnyx. Tous droits réservés.</p>
			</div>
		</footer>

	</body>
</html>
