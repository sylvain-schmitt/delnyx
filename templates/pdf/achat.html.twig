<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Facture d'achat {{ invoice.invoiceNumber ?? invoice.pdpInvoiceId }}</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: Arial, sans-serif; font-size: 11px; color: #222; padding: 30px; }
  h1 { font-size: 20px; color: #1a1a2e; margin-bottom: 4px; }
  .subtitle { font-size: 12px; color: #666; margin-bottom: 24px; }

  .parties { display: flex; justify-content: space-between; margin-bottom: 24px; gap: 20px; }
  .party { flex: 1; border: 1px solid #ddd; border-radius: 4px; padding: 12px; }
  .party-label { font-size: 9px; font-weight: bold; text-transform: uppercase; color: #888; margin-bottom: 6px; letter-spacing: 0.5px; }
  .party-name { font-size: 13px; font-weight: bold; color: #1a1a2e; margin-bottom: 2px; }
  .party-siren { font-size: 10px; color: #666; }

  .meta { display: flex; gap: 20px; margin-bottom: 24px; }
  .meta-item { flex: 1; }
  .meta-label { font-size: 9px; text-transform: uppercase; color: #888; font-weight: bold; margin-bottom: 2px; }
  .meta-value { font-size: 11px; font-weight: bold; }

  table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
  thead th { background: #1a1a2e; color: white; padding: 8px 10px; text-align: left; font-size: 10px; }
  thead th.right { text-align: right; }
  tbody tr:nth-child(even) { background: #f9f9f9; }
  tbody td { padding: 7px 10px; border-bottom: 1px solid #eee; font-size: 10px; vertical-align: top; }
  tbody td.right { text-align: right; }
  .item-desc { font-size: 9px; color: #666; margin-top: 2px; }

  .totals-container { display: flex; justify-content: flex-end; margin-bottom: 24px; }
  .totals-table { width: 280px; border: 1px solid #ddd; border-radius: 4px; overflow: hidden; }
  .totals-table tr td { padding: 6px 12px; font-size: 11px; border-bottom: 1px solid #eee; }
  .totals-table tr td:last-child { text-align: right; font-weight: bold; }
  .totals-table tr.grand-total td { background: #1a1a2e; color: white; font-size: 13px; font-weight: bold; }

  .vat-section { margin-bottom: 16px; }
  .section-title { font-size: 10px; font-weight: bold; color: #666; text-transform: uppercase; margin-bottom: 6px; }

  .footer { border-top: 1px solid #ddd; padding-top: 10px; font-size: 9px; color: #999; text-align: center; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 9px; font-weight: bold; }
  .badge-blue { background: #dbeafe; color: #1d4ed8; }
  .badge-green { background: #d1fae5; color: #065f46; }
  .status-paid { display: inline-block; margin-top: 8px; padding: 4px 12px; border-radius: 4px; background: #d1fae5; color: #065f46; font-size: 11px; font-weight: bold; border: 1px solid #6ee7b7; }
</style>
</head>
<body>

<h1>Facture d'achat reçue</h1>
<p class="subtitle">
  Reçue via Plateforme Agréée (Super PDP) — ID #{{ invoice.pdpInvoiceId }}
  {% if invoice.pdpStatus %}&nbsp;<span class="badge badge-blue">{{ invoice.pdpStatusLabel }}</span>{% endif %}
</p>
{% if invoice.localStatus == 'paid' %}
<div><span class="status-paid">✓ Payée</span></div>
{% endif %}

<div class="parties">
  <div class="party">
    <div class="party-label">Fournisseur (vendeur)</div>
    <div class="party-name">{{ en.seller.name ?? invoice.sellerName ?? '—' }}</div>
    {% if invoice.sellerSiren %}
      <div class="party-siren">SIREN : {{ invoice.sellerSiren }}</div>
    {% endif %}
    {% if en.seller.vat_identifier %}
      <div class="party-siren">TVA : {{ en.seller.vat_identifier }}</div>
    {% endif %}
  </div>
  <div class="party">
    <div class="party-label">Destinataire (acheteur)</div>
    <div class="party-name">{{ en.buyer.name ?? invoice.buyerName ?? '—' }}</div>
    {% if en.buyer.legal_registration_identifier.value is defined %}
      <div class="party-siren">SIREN : {{ en.buyer.legal_registration_identifier.value }}</div>
    {% endif %}
    {% if en.buyer.vat_identifier %}
      <div class="party-siren">TVA : {{ en.buyer.vat_identifier }}</div>
    {% endif %}
  </div>
</div>

<div class="meta">
  <div class="meta-item">
    <div class="meta-label">N° de facture</div>
    <div class="meta-value">{{ invoice.invoiceNumber ?? '—' }}</div>
  </div>
  <div class="meta-item">
    <div class="meta-label">Date d'émission</div>
    <div class="meta-value">{{ invoice.issueDate ? invoice.issueDate|date('d/m/Y') : (en.issue_date ?? '—') }}</div>
  </div>
  {% if en.payment_due_date %}
  <div class="meta-item">
    <div class="meta-label">Échéance</div>
    <div class="meta-value">{{ en.payment_due_date|date('d/m/Y') }}</div>
  </div>
  {% endif %}
  <div class="meta-item">
    <div class="meta-label">Devise</div>
    <div class="meta-value">{{ en.currency_code ?? 'EUR' }}</div>
  </div>
</div>

{% if invoice.lines|length > 0 %}
<table>
  <thead>
    <tr>
      <th style="width:40%">Désignation</th>
      <th class="right" style="width:12%">Qté</th>
      <th class="right" style="width:12%">Prix unitaire</th>
      <th class="right" style="width:10%">TVA</th>
      <th class="right" style="width:14%">Montant HT</th>
    </tr>
  </thead>
  <tbody>
    {% for line in invoice.lines %}
    <tr>
      <td>
        {{ line.item_information.name ?? '—' }}
        {% if line.item_information.description is defined %}
          <div class="item-desc">{{ line.item_information.description }}</div>
        {% endif %}
      </td>
      <td class="right">
        {{ line.invoiced_quantity|number_format(2, ',', ' ') }}
        {% if line.invoiced_quantity_code is defined %} {{ line.invoiced_quantity_code }}{% endif %}
      </td>
      <td class="right">{{ line.price_details.item_net_price|number_format(2, ',', ' ') }} €</td>
      <td class="right">{{ line.vat_information.invoiced_item_vat_rate ?? '0' }} %</td>
      <td class="right">{{ line.net_amount|number_format(2, ',', ' ') }} €</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if invoice.vatBreakdown|length > 0 %}
<div class="vat-section">
  <div class="section-title">Détail TVA</div>
  <table>
    <thead>
      <tr>
        <th>Taux TVA</th>
        <th class="right">Base HT</th>
        <th class="right">Montant TVA</th>
      </tr>
    </thead>
    <tbody>
      {% for vat in invoice.vatBreakdown %}
      <tr>
        <td>{{ vat.vat_category_rate ?? '0' }} %</td>
        <td class="right">{{ vat.vat_category_taxable_amount|number_format(2, ',', ' ') }} €</td>
        <td class="right">{{ vat.vat_category_tax_amount|number_format(2, ',', ' ') }} €</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

<div class="totals-container">
  <table class="totals-table">
    {% if en.totals.total_without_vat is defined %}
    <tr><td>Total HT</td><td>{{ en.totals.total_without_vat|number_format(2, ',', ' ') }} €</td></tr>
    {% endif %}
    {% if en.totals.total_vat_amount is defined %}
    <tr><td>Total TVA</td><td>{{ en.totals.total_vat_amount.value|number_format(2, ',', ' ') }} €</td></tr>
    {% endif %}
    <tr class="grand-total">
      <td>Total TTC</td>
      <td>{{ (en.totals.total_with_vat ?? invoice.totalTTC ?? '0')|number_format(2, ',', ' ') }} €</td>
    </tr>
  </table>
</div>

<div class="footer">
  Document généré automatiquement par Delnyx à partir de la facture électronique reçue via Super PDP (Plateforme Agréée).
</div>

</body>
</html>
