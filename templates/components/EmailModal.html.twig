{# 
    Modale réutilisable pour l'envoi d'emails
    Gérée par le contrôleur Stimulus email-modal
#}
<div data-controller="email-modal">
    <div 
        data-email-modal-target="overlay"
        data-action="click->email-modal#closeOnOverlay"
        class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4"
    >
        <div 
            data-email-modal-target="modal"
            class="bg-slate-800 rounded-lg shadow-xl max-w-md w-full border border-white/10 transform transition-all"
        >
        {# Header #}
        <div class="flex items-center justify-between p-6 border-b border-white/10">
            <h3 
                data-email-modal-target="title"
                class="text-lg font-semibold text-white"
            >
                Envoyer par email
            </h3>
            <button 
                type="button" 
                data-action="click->email-modal#close"
                class="text-white/60 hover:text-white transition-colors"
                title="Fermer"
            >
                {{ ux_icon('lucide:x', {class: 'w-5 h-5'}) }}
            </button>
        </div>
        
        {# Form #}
        <form 
            data-email-modal-target="form"
            data-action="submit->email-modal#submit"
            method="POST"
            enctype="multipart/form-data"
        >
            <input type="hidden" name="_token">
            
            <div class="p-6 space-y-4">
                {# Destinataire #}
                <div>
                    <label class="block text-sm font-medium text-white/80 mb-2">
                        Destinataire
                    </label>
                    <p class="text-white font-medium flex items-center gap-2">
                        {{ ux_icon('lucide:mail', {class: 'w-4 h-4'}) }}
                        <span data-email-modal-target="recipient">-</span>
                    </p>
                </div>
                
                {# Message personnalisé #}
                <div>
                    <label for="email-custom-message" class="block text-sm font-medium text-white/80 mb-2">
                        Message personnalisé (optionnel)
                    </label>
                    <textarea 
                        id="email-custom-message"
                        name="custom_message"
                        data-email-modal-target="message"
                        rows="4"
                        class="w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"
                        placeholder="Ajoutez un message personnalisé qui apparaîtra dans l'email..."
                    ></textarea>
                    <p class="mt-1 text-xs text-white/40">
                        Ce message sera ajouté au début de l'email
                    </p>
                </div>
                
                {# Pièces jointes supplémentaires #}
                <div>
                    <label for="email-attachments" class="block text-sm font-medium text-white/80 mb-2">
                        Pièces jointes supplémentaires (optionnel)
                    </label>
                    <div class="space-y-2">
                        <input 
                            type="file"
                            id="email-attachments"
                            name="attachments[]"
                            multiple
                            data-email-modal-target="fileInput"
                            data-action="change->email-modal#handleFileChange"
                            class="hidden"
                        >
                        <button 
                            type="button"
                            data-action="click->email-modal#openFileSelector"
                            class="w-full px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors flex items-center justify-center gap-2 border border-white/10"
                        >
                            {{ ux_icon('lucide:paperclip', {class: 'w-4 h-4'}) }}
                            Ajouter des fichiers
                        </button>
                        
                        {# Liste des fichiers sélectionnés #}
                        <div 
                            data-email-modal-target="fileList"
                            class="hidden space-y-2"
                        >
                            {# Les fichiers seront ajoutés ici dynamiquement #}
                        </div>
                    </div>
                    <p class="mt-1 text-xs text-white/40">
                        Ex: RIB, contrat, CGV... (max 10 Mo par fichier)
                    </p>
                </div>
                
                {# Canal d'envoi (factures uniquement) #}
                <div data-email-modal-target="channelSection" class="hidden">
                    <label class="block text-sm font-medium text-white/80 mb-2">
                        Canal d'envoi
                    </label>
                    <div class="grid grid-cols-3 gap-2">
                        <label class="flex flex-col items-center gap-1 p-3 rounded-lg border border-white/10 bg-slate-900/50 cursor-pointer has-[:checked]:border-blue-500 has-[:checked]:bg-blue-500/10 transition-colors">
                            <input type="radio" name="channel" value="email" data-email-modal-target="channelInput" class="sr-only" checked>
                            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            <span class="text-xs text-white/70">Email</span>
                        </label>
                        <label class="flex flex-col items-center gap-1 p-3 rounded-lg border border-white/10 bg-slate-900/50 cursor-pointer has-[:checked]:border-purple-500 has-[:checked]:bg-purple-500/10 transition-colors">
                            <input type="radio" name="channel" value="pdp" data-email-modal-target="channelInput" class="sr-only">
                            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            <span class="text-xs text-white/70">PA seule</span>
                        </label>
                        <label class="flex flex-col items-center gap-1 p-3 rounded-lg border border-white/10 bg-slate-900/50 cursor-pointer has-[:checked]:border-green-500 has-[:checked]:bg-green-500/10 transition-colors">
                            <input type="radio" name="channel" value="both" data-email-modal-target="channelInput" class="sr-only">
                            <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            <span class="text-xs text-white/70">Email + PA</span>
                        </label>
                    </div>
                    <p class="mt-1 text-xs text-white/40">PA = Plateforme Agréée (e-invoicing B2B). Ignorée pour les clients particuliers.</p>
                </div>

                {# Info PDF #}
                <div class="bg-blue-500/10 border border-blue-500/20 rounded-lg p-3">
                    <p class="text-sm text-blue-200 flex items-start gap-2">
                        {{ ux_icon('lucide:info', {class: 'w-4 h-4 mt-0.5 flex-shrink-0'}) }}
                        <span>Le document PDF sera automatiquement joint à l'email</span>
                    </p>
                </div>
            </div>
            
            {# Footer #}
            <div class="flex gap-3 p-6 border-t border-white/10 bg-slate-900/50">
                <button 
                    type="button"
                    data-action="click->email-modal#close"
                    class="flex-1 px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors"
                >
                    Annuler
                </button>
                <button 
                    type="submit"
                    class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors flex items-center justify-center gap-2"
                >
                    {{ ux_icon('lucide:send', {class: 'w-4 h-4'}) }}
                    Envoyer
                </button>
            </div>
        </form>
        </div>
    </div>
</div>


