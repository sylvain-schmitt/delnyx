{% extends 'admin/layout/base.html.twig' %}

{% block title %}Facture d'achat #{{ invoice.pdpInvoiceId }} - Administration Delnyx{% endblock %}
{% block page_title %}Facture d'achat{% endblock %}

{% block body %}
<div class="space-y-6">

    {# Header #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 scroll-animate">
        <div>
            <h1 class="text-2xl font-bold text-white">Facture reçue #{{ invoice.pdpInvoiceId }}</h1>
            <nav class="flex items-center space-x-2 text-sm text-white/60 mt-1">
                <a href="{{ path('admin_dashboard') }}" class="hover:text-white transition-colors">Dashboard</a>
                <span>{{ ux_icon('lucide:chevron-right', {class: 'w-4 h-4'}) }}</span>
                <a href="{{ path('admin_purchase_invoice_index') }}" class="hover:text-white transition-colors">Achats</a>
                <span>{{ ux_icon('lucide:chevron-right', {class: 'w-4 h-4'}) }}</span>
                <span class="text-white">#{{ invoice.pdpInvoiceId }}</span>
            </nav>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('admin_purchase_invoice_pdf', {id: invoice.id}) }}" target="_blank"
               class="btn-secondary flex items-center gap-2">
                {{ ux_icon('lucide:file-down', {class: 'w-4 h-4'}) }}
                PDF
            </a>
            <a href="{{ path('admin_purchase_invoice_index') }}" class="btn-secondary flex items-center gap-2">
                {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4'}) }}
                Retour
            </a>
        </div>
    </div>

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-lg px-4 py-3 text-sm font-medium
                {{ type == 'success' ? 'bg-green-500/20 text-green-300 border border-green-500/30' : '' }}
                {{ type == 'error' ? 'bg-red-500/20 text-red-300 border border-red-500/30' : '' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# Infos principales #}
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-xl p-6 scroll-animate">
                <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    {{ ux_icon('lucide:file-text', {class: 'w-5 h-5'}) }}
                    Informations de la facture
                </h2>
                <dl class="space-y-3">
                    <div class="flex justify-between">
                        <dt class="text-white/60 text-sm">Fournisseur</dt>
                        <dd class="text-white font-medium">{{ invoice.sellerName ?? '—' }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-white/60 text-sm">SIREN fournisseur</dt>
                        <dd class="text-white font-mono text-sm">{{ invoice.sellerSiren ?? '—' }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-white/60 text-sm">Acheteur</dt>
                        <dd class="text-white font-medium">{{ invoice.buyerName ?? '—' }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-white/60 text-sm">ID Super PDP</dt>
                        <dd class="text-white font-mono text-sm">{{ invoice.pdpInvoiceId }}</dd>
                    </div>
                    {% if invoice.externalId %}
                    <div class="flex justify-between">
                        <dt class="text-white/60 text-sm">Référence externe</dt>
                        <dd class="text-white text-sm">{{ invoice.externalId }}</dd>
                    </div>
                    {% endif %}
                    <div class="flex justify-between">
                        <dt class="text-white/60 text-sm">Date d'émission</dt>
                        <dd class="text-white text-sm">{{ invoice.issueDate ? invoice.issueDate|date('d/m/Y') : '—' }}</dd>
                    </div>
                    <div class="flex justify-between border-t border-white/10 pt-3">
                        <dt class="text-white/60 text-sm">Montant HT</dt>
                        <dd class="text-white font-semibold">{{ invoice.totalHT ? invoice.totalHT|number_format(2, ',', ' ') ~ ' €' : '—' }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-white/60 text-sm">Montant TTC</dt>
                        <dd class="text-white font-bold text-lg">{{ invoice.totalTTC ? invoice.totalTTC|number_format(2, ',', ' ') ~ ' €' : '—' }}</dd>
                    </div>
                </dl>
            </div>

            {# Réponse brute PDP #}
            {% if invoice.pdpRawResponse %}
            <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-xl p-6 scroll-animate animate-delay-100">
                <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    {{ ux_icon('lucide:code', {class: 'w-5 h-5'}) }}
                    Réponse Super PDP
                </h2>
                <pre class="text-white/70 text-xs overflow-auto max-h-48 bg-black/20 rounded-lg p-3">{{ invoice.pdpRawResponse }}</pre>
            </div>
            {% endif %}
        </div>

        {# Statuts et actions #}
        <div class="space-y-6">

            {# Statut PA #}
            <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-xl p-6 scroll-animate animate-delay-100">
                <h2 class="text-sm font-semibold text-white/60 uppercase tracking-wider mb-4">Statut PA</h2>
                {% set color = invoice.pdpStatusColor %}
                <span class="inline-flex items-center px-3 py-2 rounded-lg text-sm font-medium
                    bg-{{ color }}-500/20 text-{{ color }}-300 border border-{{ color }}-500/30">
                    {{ invoice.pdpStatusLabel }}
                </span>
            </div>

            {# Traitement local #}
            <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-xl p-6 scroll-animate animate-delay-200">
                <h2 class="text-sm font-semibold text-white/60 uppercase tracking-wider mb-4">Traitement</h2>

                {% if invoice.localStatus == 'acknowledged' %}
                    <div class="flex items-center gap-2 text-green-300 mb-4">
                        {{ ux_icon('lucide:check-circle', {class: 'w-5 h-5'}) }}
                        <span class="font-medium">Acceptée le {{ invoice.acknowledgedAt|date('d/m/Y à H:i') }}</span>
                    </div>
                {% elseif invoice.localStatus == 'rejected' %}
                    <div class="flex items-center gap-2 text-red-300 mb-2">
                        {{ ux_icon('lucide:x-circle', {class: 'w-5 h-5'}) }}
                        <span class="font-medium">Rejetée le {{ invoice.rejectedAt|date('d/m/Y à H:i') }}</span>
                    </div>
                    {% if invoice.rejectionReason %}
                        <p class="text-white/60 text-sm mb-4">{{ invoice.rejectionReason }}</p>
                    {% endif %}
                {% endif %}

                {% if invoice.localStatus == 'paid' %}
                    <div class="flex items-center gap-2 text-emerald-300 mb-4">
                        {{ ux_icon('lucide:badge-check', {class: 'w-5 h-5'}) }}
                        <span class="font-medium">Payée</span>
                    </div>
                {% endif %}

                {% if invoice.localStatus != 'acknowledged' and invoice.localStatus != 'paid' %}
                <form method="post" action="{{ path('admin_purchase_invoice_acknowledge', {id: invoice.id}) }}" class="mb-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('purchase_invoice_acknowledge_' ~ invoice.id) }}">
                    <button type="submit" class="w-full btn-primary flex items-center justify-center gap-2">
                        {{ ux_icon('lucide:check', {class: 'w-4 h-4'}) }}
                        Accepter la facture
                    </button>
                </form>
                {% endif %}

                {% if invoice.localStatus != 'paid' %}
                <form method="post" action="{{ path('admin_purchase_invoice_mark_paid', {id: invoice.id}) }}" class="mb-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('purchase_invoice_mark_paid_' ~ invoice.id) }}">
                    <button type="submit" class="w-full btn-primary flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 border-emerald-500">
                        {{ ux_icon('lucide:circle-dollar-sign', {class: 'w-4 h-4'}) }}
                        Marquer comme payée (fr:212)
                    </button>
                </form>
                {% endif %}

                {% if invoice.localStatus != 'rejected' and invoice.localStatus != 'paid' %}
                <form method="post" action="{{ path('admin_purchase_invoice_reject', {id: invoice.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('purchase_invoice_reject_' ~ invoice.id) }}">
                    <div class="mb-2">
                        <label class="text-white/60 text-xs font-medium block mb-1">Motif de rejet (optionnel)</label>
                        <textarea name="reason" rows="2"
                            class="w-full bg-white/10 border border-white/20 rounded-lg px-3 py-2 text-white text-sm placeholder-white/40 focus:outline-none focus:border-white/40"
                            placeholder="Motif du rejet…"></textarea>
                    </div>
                    <button type="submit" class="w-full btn-secondary flex items-center justify-center gap-2 text-red-400 border-red-500/30 hover:bg-red-500/10">
                        {{ ux_icon('lucide:x', {class: 'w-4 h-4'}) }}
                        Rejeter la facture
                    </button>
                </form>
                {% endif %}
            </div>

        </div>
    </div>

</div>
{% endblock %}
